{
  "expo": {
    "name": "پهناور کار",
    "slug": "PahnavarKar",
    "version": "1.6.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pahnavarkar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cleverlife.pahnavarkar",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.cleverlife.pahnavarkar",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F7F9",
          "dark": {
            "backgroundColor": "#041E28"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "برای انتخاب تصویر پروفایل، برنامه به دسترسی عکس‌های شما نیاز دارد.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ecbe587d-3bca-4a1d-885e-988ec5b87606"
      }
    },
    "owner": "pahnavar"
  }
}
